                    "pageFeatureId": "PageFeatures(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "chadcoCustomerId": "INTEGER NOT NULL",
                    "packageUnitId": "INTEGER NOT NULL",
                    "pageId": "INTEGER NOT NULL",
                    "pageFeatureId": "INTEGER NOT NULL",
                    "packageUnitCostId": "INTEGER",
                    "unitModel": "ENUM('perDuration', 'perCount', 'flat') NOT NULL",
                    "enabledDate": "TIMESTAMP NOT NULL",
                    "showDate": "TIMESTAMP NOT NULL",
                    "counter": "INTEGER DEFAULT 0"
