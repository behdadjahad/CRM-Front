{
    "database_schema": {
        "tables": {
            "ChadcoCustomer": {
                "primary_key": "id",
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "created_at": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP",
                    "updated_at": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"
                },
                "description": "Central customer entity"
            },
            "ChadcoCustomerPackage": {
                "primary_key": "id",
                "foreign_keys": {
                    "chadcoCustomerId": "ChadcoCustomer(id)",
                    "packageId": "Package(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "chadcoCustomerId": "INTEGER NOT NULL",
                    "packageId": "INTEGER NOT NULL",
                    "deletedAt": "TIMESTAMP NULL"
                },
                "description": "Customer-package associations"
            },
            "ChadcoCustomerPackageCategory": {
                "primary_key": "id",
                "foreign_keys": {
                    "chadcoCustomerId": "ChadcoCustomer(id)",
                    "packageCategoryId": "PackageCategory(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "chadcoCustomerId": "INTEGER NOT NULL",
                    "packageCategoryId": "INTEGER NOT NULL",
                    "deletedAt": "TIMESTAMP NULL"
                },
                "description": "Customer-package category associations"
            },
            "ChadcoCustomerPackageUnit": {
                "primary_key": "id",
                "foreign_keys": {
                    "chadcoCustomerId": "ChadcoCustomer(id)",
                    "packageUnitId": "PackageUnit(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "chadcoCustomerId": "INTEGER NOT NULL",
                    "packageUnitId": "INTEGER NOT NULL",
                    "deletedAt": "TIMESTAMP NULL"
                },
                "description": "Customer-package unit associations"
            },
            "Package": {
                "primary_key": "id",
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "title": "VARCHAR(255) NOT NULL",
                    "description": "TEXT",
                    "price": "DECIMAL(10,2) NOT NULL",
                    "deletedAt": "TIMESTAMP NULL"
                },
                "description": "Main package definitions"
            },
            "PackageCategory": {
                "primary_key": "id",
                "foreign_keys": {
                    "packageId": "Package(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "packageId": "INTEGER NOT NULL",
                    "title": "VARCHAR(255) NOT NULL",
                    "description": "TEXT",
                    "price": "DECIMAL(10,2) NOT NULL",
                    "deletedAt": "TIMESTAMP NULL"
