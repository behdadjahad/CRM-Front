            },
            "PackageUnit": {
                "primary_key": "id",
                "foreign_keys": {
                    "packageUnitLabelId": "PackageUnitLabel(id)",
                    "currencyId": "Currency(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "title": "VARCHAR(255) NOT NULL",
                    "description": "TEXT",
                    "packageUnitLabelId": "INTEGER",
                    "accessesJson": "JSON",
                    "unitType": "ENUM('rent', 'sale') NOT NULL",
                    "unitModel": "ENUM('perDuration', 'perCount', 'flat') NOT NULL",
                    "enabledDurationInDays": "INTEGER",
                    "showDurationInDays": "INTEGER",
                    "countUnit": "INTEGER",
                    "price": "DECIMAL(10,2) NOT NULL",
                    "currencyId": "INTEGER",
                    "deletedAt": "TIMESTAMP NULL"
                },
                "description": "Package units with pricing models"
            },
            "PackageUnitLabel": {
                "primary_key": "id",
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "label": "VARCHAR(255) NOT NULL",
                    "description": "TEXT",
                    "code": "VARCHAR(50) UNIQUE"
                },
                "description": "Package unit labels"
            },
            "PackageUnitSnapshot": {
                "primary_key": "id",
                "foreign_keys": {
                    "chadcoCustomerId": "ChadcoCustomer(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "chadcoCustomerId": "INTEGER NOT NULL",
                    "title": "VARCHAR(255) NOT NULL",
                    "description": "TEXT",
                    "accessesJson": "JSON",
                    "unitType": "ENUM('rent', 'sale') NOT NULL",
                    "unitModel": "ENUM('perDuration', 'perCount', 'flat') NOT NULL",
                    "enabledDurationInDays": "INTEGER",
                    "showDurationInDays": "INTEGER",
                    "countUnit": "INTEGER",
                    "price": "DECIMAL(10,2) NOT NULL"
                },
                "description": "Historical snapshots of package units"
            },
            "ChadcoInvoice": {
                "primary_key": "id",
                "columns": {
