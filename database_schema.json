                "description": "Customer-specific roles"
            },
            "Permission": {
                "primary_key": "id",
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "name": "VARCHAR(255) NOT NULL",
                    "description": "TEXT",
                    "resource": "VARCHAR(255) NOT NULL",
                    "action": "VARCHAR(255) NOT NULL"
                },
                "description": "System permissions"
            },
            "ChadcoCustomerPermission": {
                "primary_key": "id",
                "foreign_keys": {
                    "chadcoCustomerId": "ChadcoCustomer(id)",
                    "userId": "User(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "chadcoCustomerId": "INTEGER NOT NULL",
                    "userId": "INTEGER NOT NULL"
                },
                "description": "Customer-user permission associations"
