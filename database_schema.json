            "ChadcoCustomerAccessLog": {
                "primary_key": "id",
                "foreign_keys": {
                    "chadcoCustomerId": "ChadcoCustomer(id)",
                    "unitId": "PackageUnit(id)",
                    "pageId": "Page(id)",
                    "pageFeatureId": "PageFeatures(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "chadcoCustomerId": "INTEGER NOT NULL",
                    "unitId": "INTEGER NOT NULL",
                    "pageId": "INTEGER NOT NULL",
                    "pageFeatureId": "INTEGER NOT NULL",
                    "unitCostModel": "VARCHAR(255)",
                    "submitDate": "TIMESTAMP NOT NULL",
                    "entityId": "INTEGER",
                    "action": "VARCHAR(255) NOT NULL"
                },
                "description": "Customer access activity logs"
            },
            "Page": {
                "primary_key": "id",
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "name": "VARCHAR(255) NOT NULL",
                    "path": "VARCHAR(500) NOT NULL",
                    "description": "TEXT"
                },
                "description": "System pages"
            },
            "PageFeatures": {
                "primary_key": "id",
                "foreign_keys": {
                    "pageId": "Page(id)"
                },
                "columns": {
                    "id": "INTEGER PRIMARY KEY",
                    "pageId": "INTEGER NOT NULL",
                    "name": "VARCHAR(255) NOT NULL",
                    "description": "TEXT",
                    "featureType": "ENUM('read', 'write', 'delete', 'admin') NOT NULL"
                },
                "description": "Page-specific features"
            }
        },
        "relationships": {
            "one_to_many": [
                "ChadcoCustomer → ChadcoCustomerPackage",
                "ChadcoCustomer → ChadcoCustomerPackageCategory",
                "ChadcoCustomer → ChadcoCustomerPackageUnit",
                "ChadcoCustomer → ChadcoCustomerPermission",
                "ChadcoCustomer → ChadcoCustomerAccess",
                "ChadcoCustomer → ChadcoCustomerAccessLog",
                "ChadcoCustomer → Role",
                "ChadcoCustomer → PackageUnitSnapshot",
                "Package → PackageCategory",
                "PackageUnit → PackageUnitLabel",
                "User → ChadcoCustomerPermission",
                "Role → Permission",
                "Page → PageFeatures",
                "PackageUnit → ChadcoCustomerAccess",
                "Page → ChadcoCustomerAccess",
                "PageFeatures → ChadcoCustomerAccess",
                "Page → ChadcoCustomerAccessLog",
                "PageFeatures → ChadcoCustomerAccessLog"
            ],
            "many_to_many": [
                "User ↔ Role (through ChadcoCustomerPermission)",
                "ChadcoCustomer ↔ Package (through ChadcoCustomerPackage)",
                "ChadcoCustomer ↔ PackageCategory (through ChadcoCustomerPackageCategory)",
                "ChadcoCustomer ↔ PackageUnit (through ChadcoCustomerPackageUnit)"
            ]
        },
        "assumptions": [
            "Currency table exists but not shown in diagrams",
            "PackageUnitCost table exists but not shown in diagrams",
            "ChadcoCustomer table has standard fields (id, name, email, etc.)",
            "User table has standard authentication fields",
            "All timestamp fields use UTC timezone",
            "JSON fields store structured data for flexible access control",
            "Soft delete pattern using deletedAt field for data retention"
        ]
    }
}